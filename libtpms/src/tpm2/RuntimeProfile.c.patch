+static char *
+strndup(const char *s, size_t n)
+{
+    size_t len = strnlen(s, n);
+    char *r = malloc(len + 1);
+
+    if (r) {
+        memcpy(r, s, len);
+        r[len] = '\0';
+    }
+    return r;
+}
+#elif defined(__MINGW32__)
+/* Some mingw-w64 toolchain builds gate strndup() behind a narrower or
+ * different set of feature-test macros than others do: a real CI
+ * mingw-w64 bot fails here with an implicit-declaration error even with
+ * _GNU_SOURCE defined (above), while the local MSYS2 UCRT64 toolchain
+ * already exposes it under that same macro. Redirect to our own
+ * implementation unconditionally, rather than trying to detect
+ * availability, so this doesn't conflict with a real declaration on a
+ * toolchain build that does provide one.
+ */
+#define strndup libtpms_runtimeprofile_strndup
+static char *
+libtpms_runtimeprofile_strndup(const char *s, size_t n)
+{
+    size_t len = strnlen(s, n);
+    char *r = malloc(len + 1);
+
+    if (r) {
+        memcpy(r, s, len);
+        r[len] = '\0';
+    }
+    return r;
+}
+#endif
