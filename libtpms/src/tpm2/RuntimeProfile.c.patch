+static bool
+json_skip_map_entry(const char **pp)
+{
+    const char *p = *pp;
+
+    while (isspace((unsigned char)*p))
+        p++;
+    if (*p != '"')
+        return false;
+    p++;
+    if (*p == '"')
+        return false; /* key must be non-empty */
+    while (*p != '"') {
+        if (*p == '\0')
+            return false;
+        p++;
+    }
+    p++;
+
+    while (isspace((unsigned char)*p))
+        p++;
+    if (*p != ':')
+        return false;
+    p++;
+    while (isspace((unsigned char)*p))
+        p++;
+
+    if (*p == '"') {
+        p++;
+        while (*p != '"') {
+            if (*p == '\0')
+                return false;
+            p++;
+        }
+        p++;
+    } else if (isdigit((unsigned char)*p)) {
+        while (isdigit((unsigned char)*p))
+            p++;
+    } else {
+        return false;
+    }
+
+    while (isspace((unsigned char)*p))
+        p++;
+
+    *pp = p;
+    return true;
+}
