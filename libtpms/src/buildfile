intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

import impl_libs += libcrypto%lib{crypto}

# Public headers.
#
pub = [dir_path] ../include/libtpms/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{tpms}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
# tpm12/tpm_crypto_freebl.c is the NSS/freebl crypto backend, unused since
# this package builds with OpenSSL. tpm2/crypto/CryptRsa.c is an empty,
# unreferenced file upstream does not build (tpm2/crypto/CryptRsa.h next
# to it is a real, used header). compat/asprintf.c is only built where
# needed (see below).
#
# The sources are grouped in a libul{} utility library (rather than being
# direct prerequisites of lib{tpms}) so that def{tpms} below (Windows
# symbol export list, MSVC only) has a pre-link object file list to work
# from.
#
libul{tpms}: h{**} c{** -tpm12/tpm_crypto_freebl -tpm2/crypto/CryptRsa -compat/asprintf} \
             $impl_libs $intf_libs

libul{tpms}: c{compat/asprintf}: include = ($c.target.system == 'win32-msvc')

lib{tpms}: libul{tpms}

# Build options.
#
# The sources include the public headers with unqualified names, so the
# libtpms/ directory is also on the private header search path.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_unq = [dir_path] $out_root/include/libtpms/
src_pfx_unq = [dir_path] $src_root/include/libtpms/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

c.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
              "-I$out_pfx_inc" "-I$src_pfx_inc" \
              "-I$out_pfx_unq" "-I$src_pfx_unq"

c.poptions += -DTPM_LIBTPMS_CALLBACKS -DTPM_NV_DISK -DOPENSSL_SUPPRESS_DEPRECATED

# Upstream's configure probes each of these individually (AC_CHECK_LIB
# against libcrypto) and falls back to its own crypto-math implementation
# per-primitive when a probe fails. On any OpenSSL >= 1.1.1 (this
# package's depends floor, including 3.x, where the unsuffixed
# EC_POINT_get_affine_coordinates used by the probe is the non-deprecated
# replacement for the _GFp/_GF2m names) every probe succeeds, so these are
# set unconditionally rather than genuinely probed: the autoconf module
# only supports static platform/compiler checks, not linking against a
# dependency to test for a symbol.
#
c.poptions += -DUSE_OPENSSL_FUNCTIONS_SYMMETRIC=1 -DUSE_OPENSSL_FUNCTIONS_EC=1 \
              -DUSE_OPENSSL_FUNCTIONS_ECDSA=1 -DUSE_OPENSSL_FUNCTIONS_RSA=1 \
              -DUSE_OPENSSL_FUNCTIONS_SSKDF=1 \
              -DUSE_EC_POINT_GET_AFFINE_COORDINATES_API=1

if ($c.class == 'msvc')
  c.poptions += "/FI" "$src_base/tpm_library_conf.h"
else
  c.poptions += "-include" "$src_base/tpm_library_conf.h"

# Some sources #include <endian.h/unistd.h/sys_time.h/netinet_in.h/
# strings.h/alloca.h> unconditionally; compat/ supplies a stand-in where
# the target lacks the real header, per the autoconf catalog (via
# c.predefs below), not a raw header probe. HAVE_UNISTD_H/HAVE_SYS_TIME_H
# are overridden in build/autoconf/checks/ for MinGW-w64 (has both,
# unlike MSVC). HAVE_ALLOCA_H is project-local (no builtin entry).
#
using autoconf

h{have-headers}: in{have-headers}
{
  install = false
}

[rule_hint=c.predefs] buildfile{have-headers}: h{have-headers} h{have-headers-dep}
{
  # h{have-headers-dep} must be listed: reached only via -I, not dep
  # extraction, so dist would otherwise drop it. c.poptions is reset, not
  # appended, to avoid leaking this file's other options into the probe.
  # Variable names are lowercase so a safe default below can't shadow the
  # real c.predefs.macros lookup (same name as the check = override).
  #
  c.predefs.poptions = true
  c.poptions = "-I$src_base"
  c.predefs.macros  = HAVE_ENDIAN_H@have_endian_h
  c.predefs.macros += HAVE_UNISTD_H@have_unistd_h
  c.predefs.macros += HAVE_SYS_TIME_H@have_sys_time_h
  c.predefs.macros += HAVE_NETINET_IN_H@have_netinet_in_h
  c.predefs.macros += HAVE_STRINGS_H@have_strings_h
  c.predefs.macros += HAVE_ALLOCA_H@have_alloca_h
}

./: buildfile{have-headers}

# Restores default-target registration for dist etc, otherwise lost once
# any ./ prerequisite is declared explicitly (above).
#
./: lib{tpms}

# Safe defaults for non-perform ops. Undefined check macros extract as
# [null], not false, hence the explicit conversion below.
#
have_endian_h     = [bool] false
have_unistd_h     = [bool] false
have_sys_time_h   = [bool] false
have_netinet_in_h = [bool] false
have_strings_h    = [bool] false
have_alloca_h     = [bool] false

if ($build.meta_operation == 'perform')
{
  update buildfile{have-headers}
  source $path(buildfile{have-headers})

  have_endian_h     = ($have_endian_h     == 1 ? true : false)
  have_unistd_h     = ($have_unistd_h     == 1 ? true : false)
  have_sys_time_h   = ($have_sys_time_h   == 1 ? true : false)
  have_netinet_in_h = ($have_netinet_in_h == 1 ? true : false)
  have_strings_h    = ($have_strings_h    == 1 ? true : false)
  have_alloca_h     = ($have_alloca_h     == 1 ? true : false)
}

if (!$have_endian_h)
  c.poptions += "-I$src_base/compat/endian"

if (!$have_unistd_h)
  c.poptions += "-I$src_base/compat/unistd"

if (!$have_sys_time_h)
  c.poptions += "-I$src_base/compat/sys_time"

if (!$have_netinet_in_h)
  c.poptions += "-I$src_base/compat/netinet_in"

if (!$have_strings_h)
  c.poptions += "-I$src_base/compat/strings"

if (!$have_alloca_h)
  c.poptions += "-I$src_base/compat/alloca"

# The upstream sources cast function pointers between incompatible types
# (callback tables), leave a couple of parameters and struct fields
# intentionally unused, and are not written to be -Wpedantic-clean.
#
if ($c.class != 'msvc')
  c.coptions += -Wno-cast-function-type -Wno-unused-parameter \
                -Wno-missing-field-initializers

# GCC misjudges the write size through a TPM2B_*-style buffer pointer
# (a concretely-sized struct aliased, via union, with TPMB.h's generic
# one-byte-array TPM2B view) as 0 in AlgorithmTests.c's MakeIv().
#
if ($c.id == 'gcc')
  c.coptions += -Wno-stringop-overflow

# The TPM 1.2 DAA code (tpm_daa.c) marks unused parameters by assigning
# them to themselves (e.g. "outputData = outputData;"), which Clang
# flags but GCC does not.
#
if ($c.id.type == 'clang')
  c.coptions += -Wno-self-assign

# GCC (and clang) on mingw32 check TPMLIB_LogPrintfA's plain "printf"
# format attribute (compiler.h) against the legacy MS-CRT archetype (no
# %z), not the ANSI-compatible printf mingw-w64 actually ships, so any
# %z/64-bit conversion through TPMLIB_LogError et al. is flagged as a
# false positive.
#
if ($c.target.system == 'mingw32')
  c.coptions += -Wno-format

# TPM 1.2 support.
#
tpm12/obj{**}: c.poptions += -DTPM_V12 -DTPM_PCCLIENT -DTPM_VOLATILE_LOAD \
                          -DTPM_ENABLE_ACTIVATE -DTPM_AES -DTPM_POSIX \
                          -DTPM_NOMAINTENANCE_COMMANDS
obj{tpm_tpm12_*}: c.poptions += -DTPM_V12 -DTPM_PCCLIENT -DTPM_VOLATILE_LOAD \
                          -DTPM_ENABLE_ACTIVATE -DTPM_AES -DTPM_POSIX \
                          -DTPM_NOMAINTENANCE_COMMANDS

# TPM 2 support.
#
tpm2/obj{**}: c.poptions += "-I$src_base" \
                         "-I$src_base/crypto" "-I$src_base/crypto/openssl"
obj{tpm_tpm2_*}: c.poptions += "-I$src_base/tpm2" \
                         "-I$src_base/tpm2/crypto" "-I$src_base/tpm2/crypto/openssl"

# Unlike TPM 1.2 above, upstream does have a (real, if partial) TPM_WINDOWS
# path for the TPM 2 code, used here in place of TPM_POSIX on every target
# that lacks POSIX headers of its own (MSVC, clang in MSVC-compatibility
# mode, and MinGW: none of them define any of __linux__/__CYGWIN__/BSD/
# __APPLE__, which is what upstream's own platform checks key off).
#
if ($c.target.class == 'windows')
  tpm2_platform = -DTPM_WINDOWS
else
  tpm2_platform = -D_POSIX_ -DTPM_POSIX

tpm2/obj{**} obj{tpm_tpm2_*}: c.poptions += $tpm2_platform

# Building with -Wall -Wextra -pedantic (see Step 9 of the packaging guide)
# surfaces several -Wpedantic-only diagnostics in unmodified upstream TPM2
# headers: a zero-size array in Global.h, stray top-level ';' in OIDs.h, a
# non-constant initializer in TpmTypes.h, and __FUNCTION__ (a GNU extension)
# in GpMacros.h. Neither GCC nor Clang has a dedicated flag for any of
# these, and since -pedantic isn't part of this package's own coptions,
# consumers never see them under a normal build.
#
if ($c.class == 'gcc')
  tpm2/obj{**} obj{tpm_tpm2_*}: c.coptions += -Wno-pedantic

if ($c.target.class == 'windows')
{
  if ($c.target.system == 'mingw32')
    c.libs += -lws2_32
  else
    c.libs += ws2_32.lib
}

#obja{*}: c.poptions += -DLIBTPMS_STATIC_BUILD
#objs{*}: c.poptions += -DLIBTPMS_SHARED_BUILD

# Export options.
#
lib{tpms}:
{
  c.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc"
  c.export.libs = $intf_libs
}

#liba{tpms}: c.export.poptions += -DLIBTPMS_STATIC
#libs{tpms}: c.export.poptions += -DLIBTPMS_SHARED

# BnEccConstants.c includes this directly; it doesn't match c{}/h{} so dist
# would otherwise drop it.
#
lib{tpms}: file{tpm2/EccConstantData.inl}: include = adhoc

# The upstream-patch documentation trail (see the "Patch <file>" commits):
# neither the .orig pristine-copy symlinks nor the generated .patch files
# match c{}/h{}, so dist would otherwise drop all of them.
#
lib{tpms}: file{**.orig}: include = adhoc
lib{tpms}: file{**.patch}: include = adhoc

# Only export the public API from the shared library on ELF targets.
#
lib{tpms}: file{libtpms.syms}: include = adhoc

if ($c.target.class == 'linux' || $c.target.class == 'bsd')
  libs{tpms}: c.loptions += "-Wl,--version-script=$src_base/libtpms.syms"

libs{tpms}: def{tpms}: include = ($c.target.system == 'win32-msvc')
def{tpms}: libul{tpms}

if ($c.target.system == 'mingw32')
  c.loptions += -Wl,--export-all-symbols

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
# A final release uses the same shared library name as upstream (libtool
# version-info 10:2:10): libtpms.so.0.10.2 with SONAME libtpms.so.0 on
# Linux, libtpms.so.0 on BSD, and libtpms.0.dylib on macOS. linux@ needs
# MAJOR.MINOR[.EXTRA], macos@ and bsd@ are not implemented, so the BSD
# name is set through the extension.
#
if $version.pre_release
  lib{tpms}: bin.lib.version = "-$version.project_id"
elif ($c.target.class == 'macos')
  lib{tpms}: bin.lib.version = ".0"
elif ($c.target.class == 'bsd')
  libs{tpms}: extension = "so.0"
else
  lib{tpms}: bin.lib.version = "-0" linux@"0.10.2"

# Don't install private headers.
#
h{*}: install = false
